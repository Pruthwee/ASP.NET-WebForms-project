@page
@model Films.Web.Pages.Directors.DetailsModel
@{
    ViewData["Title"] = "Director Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h2 class="mb-0"><i class="bi bi-person-badge"></i> Director Details</h2>
                </div>
                <div class="card-body">
                    @if (Model.Director != null)
                    {
                        <dl class="row">
                            <dt class="col-sm-3">First Name</dt>
                            <dd class="col-sm-9">@Model.Director.Name</dd>

                            <dt class="col-sm-3">Last Name</dt>
                            <dd class="col-sm-9">@Model.Director.Name</dd>

                            <dt class="col-sm-3">Full Name</dt>
                            <dd class="col-sm-9"><strong>@Model.Director.Name @Model.Director.Name</strong></dd>

                            <dt class="col-sm-3">Director ID</dt>
                            <dd class="col-sm-9"><code>@Model.Director.Id</code></dd>
                        </dl>

                        @if (Model.Films != null && Model.Films.Any())
                        {
                            <hr />
                            <h4 class="mt-3"><i class="bi bi-film"></i> Directed Films</h4>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Title</th>
                                            <th>Year</th>
                                            <th>Genre</th>
                                            <th>Running Time</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var film in Model.Films)
                                        {
                                            <tr>
                                                <td>@film.Title</td>
                                                <td>@film.Year</td>
                                                <td>@(film.Genre ?? "N/A")</td>
                                                <td>@(film.RunningTime.HasValue ? $"{film.RunningTime.Value} min" : "N/A")</td>
                                                <td>
                                                    <a asp-page="/Films/Details" asp-route-id="@film.FilmId" class="btn btn-sm btn-info">
                                                        <i class="bi bi-eye"></i> View
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <p class="text-muted">Total films directed: @Model.Films.Count()</p>
                        }
                        else
                        {
                            <hr />
                            <div class="alert alert-info" role="alert">
                                <i class="bi bi-info-circle"></i> This director has not directed any films yet.
                            </div>
                        }

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <div>
                                <a asp-page="./Edit" asp-route-id="@Model.Director.Id" class="btn btn-warning me-2">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-page="./Delete" asp-route-id="@Model.Director.Id" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> Director not found.
                        </div>
                        <a asp-page="./Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
