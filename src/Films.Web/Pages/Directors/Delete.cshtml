@page
@model Films.Web.Pages.Directors.DeleteModel
@{
    ViewData["Title"] = "Delete Director";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0"><i class="bi bi-trash"></i> Delete Director</h2>
                </div>
                <div class="card-body">
                    @if (Model.Director != null)
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>Warning!</strong> Are you sure you want to delete this director? This action cannot be undone.
                        </div>

                        <h4 class="mb-3">Director Details:</h4>
                        <dl class="row">
                            <dt class="col-sm-3">First Name</dt>
                            <dd class="col-sm-9">@Model.Director.Name</dd>

                            <dt class="col-sm-3">Last Name</dt>
                            <dd class="col-sm-9">@Model.Director.Name</dd>

                            <dt class="col-sm-3">Full Name</dt>
                            <dd class="col-sm-9"><strong>@Model.Director.Name @Model.Director.Name</strong></dd>

                            <dt class="col-sm-3">Director ID</dt>
                            <dd class="col-sm-9"><code>@Model.Director.Id</code></dd>
                        </dl>

                        @if (Model.FilmCount > 0)
                        {
                            <div class="alert alert-info" role="alert">
                                <i class="bi bi-info-circle"></i> This director has directed <strong>@Model.FilmCount</strong> film(s). Deleting this director may affect those records.
                            </div>
                        }

                        <form method="post">
                            <input type="hidden" asp-for="Director.Id" />
                            <div class="d-flex justify-content-between mt-4">
                                <a asp-page="./Index" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Confirm Delete
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> Director not found.
                        </div>
                        <a asp-page="./Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
