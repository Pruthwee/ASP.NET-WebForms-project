@page
@model Films.Web.Pages.Actors.IndexModel
@{
    ViewData["Title"] = "Actors";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Actors</h1>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Actor
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="get" class="mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <input type="text" class="form-control" name="searchString" value="@Model.CurrentFilter" placeholder="Search actors by name..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-secondary w-100">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
            <div class="col-md-3">
                <a asp-page="./Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </div>
    </form>

    @if (Model.Actors != null && Model.Actors.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-page="./Index" asp-route-sortOrder="@Model.FirstNameSortParam" asp-route-currentFilter="@Model.CurrentFilter">
                                First Name
                                @if (Model.CurrentSort == "firstname_asc")
                                {
                                    <i class="bi bi-arrow-up"></i>
                                }
                                else if (Model.CurrentSort == "firstname_desc")
                                {
                                    <i class="bi bi-arrow-down"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-page="./Index" asp-route-sortOrder="@Model.LastNameSortParam" asp-route-currentFilter="@Model.CurrentFilter">
                                Last Name
                                @if (Model.CurrentSort == "lastname_asc")
                                {
                                    <i class="bi bi-arrow-up"></i>
                                }
                                else if (Model.CurrentSort == "lastname_desc")
                                {
                                    <i class="bi bi-arrow-down"></i>
                                }
                            </a>
                        </th>
                        <th>Gender</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var actor in Model.Actors)
                    {
                        <tr>
                            <td>@actor.FirstName</td>
                            <td>@actor.LastName</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(actor.Gender))
                                {
                                    <span class="badge bg-secondary">@actor.Gender</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not specified</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-page="./Details" asp-route-id="@actor.ActorId" class="btn btn-sm btn-info" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="./Edit" asp-route-id="@actor.ActorId" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-page="./Delete" asp-route-id="@actor.ActorId" class="btn btn-sm btn-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Actors pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.CurrentPage - 1)" asp-route-sortOrder="@Model.CurrentSort" asp-route-currentFilter="@Model.CurrentFilter">
                            Previous
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-pageNumber="@i" asp-route-sortOrder="@Model.CurrentSort" asp-route-currentFilter="@Model.CurrentFilter">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.CurrentPage + 1)" asp-route-sortOrder="@Model.CurrentSort" asp-route-currentFilter="@Model.CurrentFilter">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        }

        <p class="text-muted text-center">
            Showing @Model.Actors.Count() of @Model.TotalCount actors
        </p>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> No actors found. @(string.IsNullOrEmpty(Model.CurrentFilter) ? "Click 'Create New Actor' to add your first actor." : "Try a different search term.")
        </div>
    }
</div>
