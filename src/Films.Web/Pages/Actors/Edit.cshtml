@page
@model Films.Web.Pages.Actors.EditModel
@{
    ViewData["Title"] = "Edit Actor";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h2 class="mb-0"><i class="bi bi-pencil"></i> Edit Actor</h2>
                </div>
                <div class="card-body">
                    @if (Model.Actor != null)
                    {
                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            
                            <input type="hidden" asp-for="Actor.Id" />

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Actor.Name" class="form-label"></label>
                                        <input asp-for="Actor.Name" class="form-control" placeholder="Enter first name" />
                                        <span asp-validation-for="Actor.Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Actor.Name" class="form-label"></label>
                                        <input asp-for="Actor.Name" class="form-control" placeholder="Enter last name" />
                                        <span asp-validation-for="Actor.Name" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Actor.SexName" class="form-label"></label>
                                <select asp-for="Actor.SexName" class="form-select">
                                    <option value="">-- Select Gender (Optional) --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Non-binary">Non-binary</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Actor.SexName" class="text-danger"></span>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <a asp-page="./Index" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Back to List
                                </a>
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-save"></i> Save Changes
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> Actor not found.
                        </div>
                        <a asp-page="./Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
