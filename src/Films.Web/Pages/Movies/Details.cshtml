@page
@model Films.Web.Pages.Movies.DetailsModel
@{
    ViewData["Title"] = "Film Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h2 class="mb-0"><i class="bi bi-film"></i> Film Details</h2>
                </div>
                <div class="card-body">
                    @if (Model.Film != null)
                    {
                        <dl class="row">
                            <dt class="col-sm-3">Title</dt>
                            <dd class="col-sm-9">@Model.Film.Title</dd>

                            <dt class="col-sm-3">Year</dt>
                            <dd class="col-sm-9">@Model.Film.Year</dd>

                            <dt class="col-sm-3">Genre</dt>
                            <dd class="col-sm-9">@(Model.Film.Genre ?? "Not specified")</dd>

                            <dt class="col-sm-3">Running Time</dt>
                            <dd class="col-sm-9">
                                @if (Model.Film.RunningTime.HasValue)
                                {
                                    @Model.Film.RunningTime.Value <text>minutes</text>
                                }
                                else
                                {
                                    <text>Not specified</text>
                                }
                            </dd>

                            <dt class="col-sm-3">Film ID</dt>
                            <dd class="col-sm-9"><code>@Model.Film.Id</code></dd>
                        </dl>

                        @if (Model.Directors != null && Model.Directors.Any())
                        {
                            <hr />
                            <h4 class="mt-3"><i class="bi bi-person-badge"></i> Directors</h4>
                            <ul class="list-group mb-3">
                                @foreach (var director in Model.Directors)
                                {
                                    <li class="list-group-item">
                                        <strong>@director.Name @</strong>
                                    </li>
                                }
                            </ul>
                        }

                        @if (Model.Actors != null && Model.Actors.Any())
                        {
                            <hr />
                            <h4 class="mt-3"><i class="bi bi-people"></i> Cast</h4>
                            <ul class="list-group mb-3">
                                @foreach (var actor in Model.Actors)
                                {
                                    <li class="list-group-item">
                                        <strong>@actor.Name @</strong>
                                        @if (!string.IsNullOrWhiteSpace(actor.SexName))
                                        {
                                            <span class="badge bg-secondary">@actor.SexName</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <div>
                                <a asp-page="./Edit" asp-route-id="@Model.Film.Id" class="btn btn-warning me-2">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-page="./Delete" asp-route-id="@Model.Film.Id" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> Film not found.
                        </div>
                        <a asp-page="./Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
