@page
@model Films.Web.Pages.Movies.DeleteModel
@{
    ViewData["Title"] = "Delete Film";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0"><i class="bi bi-trash"></i> Delete Film</h2>
                </div>
                <div class="card-body">
                    @if (Model.Film != null)
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>Warning!</strong> Are you sure you want to delete this film? This action cannot be undone.
                        </div>

                        <h4 class="mb-3">Film Details:</h4>
                        <dl class="row">
                            <dt class="col-sm-3">Title</dt>
                            <dd class="col-sm-9">@Model.Film.Title</dd>

                            <dt class="col-sm-3">Year</dt>
                            <dd class="col-sm-9">@Model.Film.Year</dd>

                            <dt class="col-sm-3">Genre</dt>
                            <dd class="col-sm-9">@(Model.Film.Genre ?? "Not specified")</dd>

                            <dt class="col-sm-3">Running Time</dt>
                            <dd class="col-sm-9">
                                @if (Model.Film.RunningTime.HasValue)
                                {
                                    @Model.Film.RunningTime.Value <text>minutes</text>
                                }
                                else
                                {
                                    <text>Not specified</text>
                                }
                            </dd>

                            <dt class="col-sm-3">Film ID</dt>
                            <dd class="col-sm-9"><code>@Model.Film.Id</code></dd>
                        </dl>

                        <form method="post">
                            <input type="hidden" asp-for="Film.Id" />
                            <div class="d-flex justify-content-between mt-4">
                                <a asp-page="./Index" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Confirm Delete
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> Film not found.
                        </div>
                        <a asp-page="./Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
